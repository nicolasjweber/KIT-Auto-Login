{
  "manifest_version": 3,
  "name": "KIT Auto-Login",
  "version": "2026.11.3",
  "description": "Zero-click login for KIT services. Automatically clicks through the login for ILIAS, CAS Campus, and other portals.",
  "browser_specific_settings": {
    "gecko": {
      "id": "{37143706-86ed-480c-940c-7353399874cc}",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {}
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["storage"],
  "optional_permissions": ["clipboardRead"],
  "background": {
    "service_worker": "scripts/background.js",
    "scripts": ["scripts/sites.js", "scripts/background.js"]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self';"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "action": {
    "default_popup": "options/options.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://idp.scc.kit.edu/*",
        "https://ilias.studium.kit.edu/*",
        "https://koala.kit.edu/*",
        "https://ilias-medien.bibliothek.kit.edu/*",
        "https://campus.studium.kit.edu/*",
        "https://lt2srv.iar.kit.edu/*",
        "https://lecture-translator.kit.edu/*",
        "https://bewerbung.studium.kit.edu/*",
        "https://plus.campus.kit.edu/*",
        "https://portal.wiwi.kit.edu/*",
        "https://gitlab.kit.edu/*",
        "https://my.scc.kit.edu/*",
        "https://fels.scc.kit.edu/*",
        "https://login.bwidm.de/*",
        "https://bwidm.scc.kit.edu/*",
        "https://ki-toolbox.scc.kit.edu/*",
        "https://hub.bwjupyter.de/*",
        "https://bwsyncandshare.kit.edu/*",
        "https://mein-hochschul.sport.kit.edu/*",
        "https://signmeup.studium.kit.edu/*"
      ],
      "js": ["scripts/utils.js", "scripts/sites.js", "scripts/main.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://fels.scc.kit.edu/*",
        "https://login.bwidm.de/*",
        "https://bwidm.scc.kit.edu/*"
      ],
      "js": ["scripts/federated_login_main.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
